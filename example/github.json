{
  "openapi": "3.0.3",
  "info": {
    "version": "1.1.4",
    "title": "GitHub v3 REST API",
    "description": "Trimmed GitHub repository workflow fixture for api-parser.",
    "license": {
      "name": "MIT",
      "url": "https://spdx.org/licenses/MIT"
    },
    "termsOfService": "https://docs.github.com/articles/github-terms-of-service",
    "contact": {
      "name": "Support",
      "url": "https://support.github.com/contact?tags=dotcom-rest-api"
    },
    "x-github-plan": "api.github.com"
  },
  "tags": [
    {
      "name": "repos",
      "description": "Interact with GitHub repositories."
    }
  ],
  "servers": [
    {
      "url": "https://api.github.com"
    }
  ],
  "externalDocs": {
    "description": "GitHub REST API documentation",
    "url": "https://docs.github.com/rest"
  },
  "paths": {
    "/users/{owner}/repos": {
      "get": {
        "summary": "List repositories for a user",
        "tags": [
          "repos"
        ],
        "x-res-type": "full-reload",
        "operationId": "repos/list-for-user",
        "parameters": [
          {
            "$ref": "#/components/parameters/owner"
          },
          {
            "$ref": "#/components/parameters/per-page"
          },
          {
            "$ref": "#/components/parameters/page"
          },
          {
            "$ref": "#/components/parameters/authorization"
          }
        ],
        "responses": {
          "200": {
            "description": "User repositories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/repository-summary"
                  }
                }
              }
            },
            "headers": {
              "Link": {
                "$ref": "#/components/headers/link"
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/not_found"
          }
        }
      }
    },
    "/repos/{owner}/{repo}": {
      "get": {
        "summary": "Get a repository",
        "tags": [
          "repos"
        ],
        "x-res-type": "full-reload",
        "operationId": "repos/get",
        "parameters": [
          {
            "$ref": "#/components/parameters/owner"
          },
          {
            "$ref": "#/components/parameters/repo"
          },
          {
            "$ref": "#/components/parameters/authorization"
          }
        ],
        "responses": {
          "200": {
            "description": "Repository details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/repository"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/forbidden"
          },
          "404": {
            "$ref": "#/components/responses/not_found"
          }
        }
      }
    },
    "/repos/{owner}/{repo}/branches": {
      "get": {
        "summary": "List branches",
        "tags": [
          "repos"
        ],
        "x-res-type": "full-reload",
        "operationId": "repos/list-branches",
        "parameters": [
          {
            "$ref": "#/components/parameters/owner"
          },
          {
            "$ref": "#/components/parameters/repo"
          },
          {
            "name": "protected",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "$ref": "#/components/parameters/per-page"
          },
          {
            "$ref": "#/components/parameters/page"
          },
          {
            "$ref": "#/components/parameters/authorization"
          }
        ],
        "responses": {
          "200": {
            "description": "Repository branches",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/branch"
                  }
                }
              }
            },
            "headers": {
              "Link": {
                "$ref": "#/components/headers/link"
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/not_found"
          }
        }
      }
    },
    "/repos/{owner}/{repo}/contributors": {
      "get": {
        "summary": "List contributors",
        "tags": [
          "repos"
        ],
        "x-res-type": "full-reload",
        "operationId": "repos/list-contributors",
        "parameters": [
          {
            "$ref": "#/components/parameters/owner"
          },
          {
            "$ref": "#/components/parameters/repo"
          },
          {
            "name": "anon",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false",
                "1"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/per-page"
          },
          {
            "$ref": "#/components/parameters/page"
          },
          {
            "$ref": "#/components/parameters/authorization"
          }
        ],
        "responses": {
          "200": {
            "description": "Repository contributors",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/contributor"
                  }
                }
              }
            },
            "headers": {
              "Link": {
                "$ref": "#/components/headers/link"
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/not_found"
          }
        }
      }
    },
    "/repos/{owner}/{repo}/releases/latest": {
      "get": {
        "summary": "Get the latest release",
        "tags": [
          "repos"
        ],
        "x-res-type": "full-reload",
        "operationId": "repos/get-latest-release",
        "parameters": [
          {
            "$ref": "#/components/parameters/owner"
          },
          {
            "$ref": "#/components/parameters/repo"
          },
          {
            "$ref": "#/components/parameters/authorization"
          }
        ],
        "responses": {
          "200": {
            "description": "Latest release",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/release"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/not_found"
          }
        }
      }
    },
    "/repos/{owner}/{repo}/commits": {
      "get": {
        "summary": "List commits",
        "tags": [
          "repos"
        ],
        "x-res-type": "incremental",
        "x-incremental": {
          "strategy": "head-watermark",
          "items-path": "$",
          "watermark": {
            "path": "commit.author.date",
            "type": "datetime"
          },
          "key-paths": [
            "sha"
          ]
        },
        "operationId": "repos/list-commits",
        "parameters": [
          {
            "$ref": "#/components/parameters/owner"
          },
          {
            "$ref": "#/components/parameters/repo"
          },
          {
            "name": "sha",
            "description": "Branch or commit SHA to start listing commits from.",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/per-page"
          },
          {
            "$ref": "#/components/parameters/page"
          },
          {
            "$ref": "#/components/parameters/authorization"
          }
        ],
        "responses": {
          "200": {
            "description": "Repository commits",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/commit"
                  }
                }
              }
            },
            "headers": {
              "Link": {
                "$ref": "#/components/headers/link"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/bad_request"
          },
          "404": {
            "$ref": "#/components/responses/not_found"
          },
          "409": {
            "$ref": "#/components/responses/conflict"
          },
          "500": {
            "$ref": "#/components/responses/internal_error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "repository-summary": {
        "type": "object",
        "x-table-name": "repo_catalog",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "x-pk": true
          },
          "name": {
            "type": "string",
            "x-response-data": {
              "id": "repoName"
            }
          },
          "full_name": {
            "type": "string"
          },
          "private": {
            "type": "boolean"
          },
          "default_branch": {
            "type": "string"
          },
          "pushed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "repository": {
        "type": "object",
        "x-table-name": "repo_details",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "x-pk": true
          },
          "name": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "private": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "default_branch": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "nullable": true
          },
          "visibility": {
            "type": "string"
          },
          "stargazers_count": {
            "type": "integer"
          },
          "forks_count": {
            "type": "integer"
          },
          "open_issues_count": {
            "type": "integer"
          },
          "pushed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "branch": {
        "type": "object",
        "x-table-name": "repo_branches",
        "properties": {
          "name": {
            "type": "string",
            "x-pk": true
          },
          "protected": {
            "type": "boolean"
          },
          "commit": {
            "type": "object",
            "properties": {
              "sha": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      },
      "contributor": {
        "type": "object",
        "x-table-name": "repo_contributors",
        "properties": {
          "login": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64",
            "x-pk": true
          },
          "type": {
            "type": "string"
          },
          "site_admin": {
            "type": "boolean"
          },
          "contributions": {
            "type": "integer"
          }
        }
      },
      "release": {
        "type": "object",
        "x-table-name": "repo_latest_release",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "x-pk": true
          },
          "tag_name": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "draft": {
            "type": "boolean"
          },
          "prerelease": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "commit": {
        "type": "object",
        "x-table-name": "repo_commits",
        "properties": {
          "sha": {
            "type": "string",
            "x-pk": true
          },
          "node_id": {
            "type": "string"
          },
          "html_url": {
            "type": "string",
            "format": "uri"
          },
          "comments_url": {
            "type": "string",
            "format": "uri"
          },
          "commit": {
            "type": "object",
            "properties": {
              "author": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "basic-error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "documentation_url": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "parameters": {
      "owner": {
        "name": "owner",
        "description": "Repository owner.",
        "in": "path",
        "required": true,
        "x-param-data": {
          "type": "values",
          "values": [
            "Lokhmat"
          ]
        },
        "schema": {
          "type": "string"
        }
      },
      "repo": {
        "name": "repo",
        "description": "Repository name.",
        "in": "path",
        "required": true,
        "x-param-data": {
          "type": "operation",
          "operation-id": "repoName"
        },
        "schema": {
          "type": "string"
        }
      },
      "per-page": {
        "name": "per_page",
        "description": "Number of results per page.",
        "in": "query",
        "x-param-data": {
          "type": "values",
          "values": [
            5
          ]
        },
        "schema": {
          "type": "integer",
          "default": 30
        }
      },
      "page": {
        "name": "page",
        "description": "Page number for paginated responses.",
        "in": "query",
        "x-param-data": {
          "type": "offset",
          "offset": {
            "start": 1,
            "increment": 1
          }
        },
        "schema": {
          "type": "integer",
          "default": 1
        }
      },
      "authorization": {
        "name": "authorization",
        "in": "header",
        "x-auth": "GITHUB_API",
        "schema": {
          "type": "string"
        }
      }
    },
    "headers": {
      "link": {
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "bad_request": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/basic-error"
            }
          }
        }
      },
      "conflict": {
        "description": "Conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/basic-error"
            }
          }
        }
      },
      "forbidden": {
        "description": "Forbidden",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/basic-error"
            }
          }
        }
      },
      "internal_error": {
        "description": "Internal error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/basic-error"
            }
          }
        }
      },
      "not_found": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/basic-error"
            }
          }
        }
      }
    }
  }
}
